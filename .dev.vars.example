# Local development secrets for Cloudflare Pages Functions.
# Copy this file to `.dev.vars` and fill in real values for local development.
# `.dev.vars` is gitignored and never deployed.
#
# For production, set these as encrypted environment variables in the
# Cloudflare Pages dashboard (Settings > Environment variables) or via
# `wrangler pages secret put KEY_NAME`.

ADMIN_PASSWORD=changeme
R2_BUCKET_NAME=the-outfit-lab-images
D1_DATABASE_ID=replace-with-your-d1-database-id

# Resend (https://resend.com) is used to notify waitlist subscribers.
# The FROM_EMAIL must use a domain verified in your Resend account.
RESEND_API_KEY=replace-with-your-resend-api-key
FROM_EMAIL=notify@theoutfitlab.co
